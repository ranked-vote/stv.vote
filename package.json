{
	"name": "stv.vote",
	"description": "Detailed reports on Single Transferable Vote elections",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "cp data.sqlite3 static/data.sqlite3 && vite dev",
		"prebuild": "STV_SVELTE_OUT_DIR=.svelte-kit-build svelte-kit sync",
		"build": "cp data.sqlite3 static/data.sqlite3 && STV_SVELTE_OUT_DIR=.svelte-kit-build vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix .",
		"generate-images": "bun scripts/generate-share-images.mjs",
		"init-db": "bun scripts/init-database.js",
		"load-scotland": "bun scripts/load-scotland.ts",
		"load-portland": "bun scripts/load-portland.ts",
		"load-albany": "bun scripts/load-albany.ts",
		"load-minneapolis": "bun scripts/load-minneapolis.ts",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:ci": "bun test --coverage",
		"prepare": "trunk git-hooks sync || true"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.2",
		"@types/bun": "^1.3.6",
		"csv-parse": "^6.1.0",
		"d3-array": "^3.2.4",
		"d3-force": "^3.0.0",
		"katex": "^0.18.1",
		"tippy.js": "^6.3.7",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tsconfig/svelte": "^5.0.6",
		"@types/node": "^25.0.0",
		"husky": "^9.1.7",
		"oxlint": "^1.76.0",
		"puppeteer": "^24.32.1",
		"svelte": "^5.45.8",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.7"
	}
}
