{
	"name": "stv.vote",
	"description": "Detailed reports on Single Transferable Vote elections",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"dev": "cp data.sqlite3 static/data.sqlite3 && vite dev",
		"prebuild": "STV_SVELTE_OUT_DIR=.svelte-kit-build svelte-kit sync",
		"build": "cp data.sqlite3 static/data.sqlite3 && STV_SVELTE_OUT_DIR=.svelte-kit-build vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix .",
		"generate-images": "bun scripts/generate-share-images.mjs",
		"init-db": "bun scripts/init-database.js",
		"load-scotland": "bun scripts/load-scotland.ts",
		"load-portland": "bun scripts/load-portland.ts",
		"load-albany": "bun scripts/load-albany.ts",
		"load-minneapolis": "bun scripts/load-minneapolis.ts",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:ci": "bun test --coverage",
		"prepare": "trunk git-hooks sync || true"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@types/bun": "^1.4.5",
		"csv-parse": "^7.0.3",
		"d3-array": "^3.2.5",
		"d3-force": "^3.0.1",
		"katex": "^0.19.1",
		"tippy.js": "^6.3.7",
		"tslib": "^2.9.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tsconfig/svelte": "^5.0.9",
		"@types/node": "^26.6.6",
		"husky": "^9.1.7",
		"oxlint": "^1.94.0",
		"puppeteer": "^25.18.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
